<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Подача заявления</title>
  <link rel="stylesheet" href="/css/forms-theme.css">
</head>

<body>
    <main class="container">
        <div class="card">
            <div class="form-header-content" style="margin-bottom:24px;">
                <div class="form-icon">📝</div>
                <div>
                    <h1>Подача заявления</h1>
                    <p class="subtitle">Заполните данные кандидата. После отправки заявление будет передано ответственному составу EMS.</p>
                </div>
            </div>

            <div class="user-info">
                <p>
                    <strong>Discord:</strong>
                    <%= user.global_name || user.username %>
                </p>

                <p>
                    <strong>Discord ID:</strong>
                    <%= user.id %>
                </p>
            </div>

            <form action="/application" method="POST">
                <div class="field">
                    <label for="characterName">Имя и фамилия персонажа</label>
                    <input
                        id="characterName"
                        name="characterName"
                        type="text"
                        required
                    >
                </div>

                <div class="field">
                    <label for="age">Возраст персонажа</label>
                    <input
                        id="age"
                        name="age"
                        type="number"
                        min="18"
                        max="100"
                        required
                    >
                </div>

                <div class="field">
                    <label for="phone">Номер телефона персонажа</label>
                    <input
                        id="phone"
                        name="phone"
                        type="text"
                        required
                    >
                </div>

                <div class="field">
                    <label for="department">Желаемое направление</label>
                    <select id="department" name="department" required>
                        <option value="">Выберите направление</option>
                        <option value="EMS">EMS</option>
                        <option value="Fire Department">Fire Department</option>
                        <option value="Administration">Administration</option>
                    </select>
                </div>

                <div class="field">
                    <label for="experience">Опыт работы</label>
                    <textarea
                        id="experience"
                        name="experience"
                        required
                    ></textarea>
                </div>

                <div class="field">
                    <label for="motivation">Почему вы хотите вступить?</label>
                    <textarea
                        id="motivation"
                        name="motivation"
                        required
                    ></textarea>
                </div>

                <div class="field">
                    <label for="timezone">Ваш часовой пояс</label>
                    <input
                        id="timezone"
                        name="timezone"
                        type="text"
                        placeholder="Например: UTC+3"
                        required
                    >
                </div>

                <div class="actions">
                    <button type="submit">
                        Отправить заявление
                    </button>

                    <a class="back-button" href="/dashboard">
                        Назад
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>