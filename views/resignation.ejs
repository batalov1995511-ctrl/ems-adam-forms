<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Заявление на увольнение</title>
  <link rel="stylesheet" href="/css/forms-theme.css">
</head>

<body>
    <main class="container">
        <div class="card">
            <div class="form-header-content" style="margin-bottom:24px;">
                <div class="form-icon">📤</div>
                <div>
                    <h1>Заявление на увольнение</h1>
                    <p class="subtitle">Заполните форму для подачи заявления на увольнение из Emergency Medical Services.</p>
                </div>
            </div>

            <p class="description">
                Заполните форму для подачи заявления на увольнение.
            </p>

            <div class="user-info">
                <p>
                    <strong>Discord:</strong>
                    <%= user.global_name || user.username %>
                </p>

                <p>
                    <strong>Discord ID:</strong>
                    <%= user.id %>
                </p>
            </div>

            <form action="/auth/resignation" method="POST">
                <div class="field">
                    <label for="characterInfo">
                        Фамилия Имя | Статик
                    </label>

                    <input
                        id="characterInfo"
                        name="characterInfo"
                        type="text"
                        maxlength="150"
                        placeholder="Например: Adam Smith | 358187"
                        required
                    >
                </div>

                <div class="field">
                    <label for="rank">
                        Ранг при увольнении
                        <span class="optional">(необязательно)</span>
                    </label>

                    <input
                        id="rank"
                        name="rank"
                        type="text"
                        maxlength="100"
                        placeholder="Например: 8"
                    >
                </div>

                <div class="field">
                    <label for="reason">
                        Причина увольнения
                    </label>

                    <textarea
                        id="reason"
                        name="reason"
                        maxlength="1000"
                        placeholder="Укажите причину увольнения"
                        required
                    ></textarea>
                </div>

                <div class="field">
                    <label for="activeReprimand">
                        Имеется ли активный выговор?
                    </label>

                    <select
                        id="activeReprimand"
                        name="activeReprimand"
                        required
                    >
                        <option value="">
                            Выберите ответ
                        </option>

                        <option value="Нет">
                            Нет
                        </option>

                        <option value="Да">
                            Да
                        </option>
                    </select>
                </div>

                <div class="actions">
                    <button type="submit">
                        Отправить заявление
                    </button>

                    <a class="back-button" href="/dashboard">
                        Назад
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>