<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Перевод сотрудника между отделами | EMS</title>
  <link rel="stylesheet" href="/css/forms-theme.css">
</head>

<body>
    <main class="page-container">
        <div class="top-panel">
            <a
                class="back-link"
                href="/dashboard"
            >
                ← Вернуться в личный кабинет
            </a>

            <div class="user-panel">
                <% if (user.avatar) { %>
                    <img
                        class="user-avatar"
                        src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                        alt="Аватар пользователя"
                    >
                <% } %>

                <span>
                    <%= user.global_name || user.username %>
                </span>
            </div>
        </div>

        <section class="form-card">
            <header class="form-header">
                <div class="form-header-content">
                    <div class="form-icon">
                        🔁
                    </div>

                    <div>
                        <h1 class="form-title">
                            Перевод сотрудника между отделами
                        </h1>

                        <p class="form-description">
                            Служебная форма для старшего состава EMS.
                            Выберите исходный и принимающий отдел,
                            а также укажите данные переводимого сотрудника.
                        </p>
                    </div>
                </div>
            </header>

            <div class="form-content">
                <% if (error) { %>
                    <div class="alert alert-error">
                        <strong>Ошибка:</strong>
                        <%= error %>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success">
                        <strong>Готово:</strong>
                        <%= success %>
                    </div>
                <% } %>

                <form
                    id="staff-transfer-form"
                    method="POST"
                    action="/forms/staff-department-transfer"
                >
                    <div class="section-title">
                        Данные оформляющего перевод
                    </div>

                    <div class="form-group">
                        <label for="discordId">
                            Discord ID
                        </label>

                        <input
                            id="discordId"
                            type="text"
                            value="<%= user.id %>"
                            readonly
                        >

                        <p class="field-hint">
                            Discord ID получен автоматически из вашей сессии.
                        </p>
                    </div>

                    <div class="section-title">
                        Данные перевода
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="fromDepartment">
                                Из какого отдела переводится сотрудник
                                <span class="required">*</span>
                            </label>

                            <select
                                id="fromDepartment"
                                name="fromDepartment"
                                required
                            >
                                <option value="">
                                    Выберите отдел
                                </option>

                                <% [
                                    "HAD",
                                    "PM",
                                    "SD",
                                    "EMT",
                                    "DI",
                                    "PSED"
                                ].forEach((department) => { %>
                                    <option
                                        value="<%= department %>"
                                        <%= formData.fromDepartment === department
                                            ? "selected"
                                            : "" %>
                                    >
                                        <%= department %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="toDepartment">
                                В какой отдел переводится сотрудник
                                <span class="required">*</span>
                            </label>

                            <select
                                id="toDepartment"
                                name="toDepartment"
                                required
                            >
                                <option value="">
                                    Выберите отдел
                                </option>

                                <% [
                                    "HAD",
                                    "PM",
                                    "SD",
                                    "EMT",
                                    "DI",
                                    "PSED"
                                ].forEach((department) => { %>
                                    <option
                                        value="<%= department %>"
                                        <%= formData.toDepartment === department
                                            ? "selected"
                                            : "" %>
                                    >
                                        <%= department %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div
                        id="same-department-warning"
                        class="warning-box"
                    >
                        Нельзя оформить перевод сотрудника
                        в тот же отдел, в котором он уже состоит.
                    </div>

                    <div class="form-group">
                        <label for="employeeName">
                            Имя Фамилия | Статик
                            <span class="required">*</span>
                        </label>

                        <input
                            id="employeeName"
                            name="employeeName"
                            type="text"
                            maxlength="120"
                            placeholder="Adam Smith | 111111"
                            value="<%= formData.employeeName || "" %>"
                            autocomplete="off"
                            required
                        >

                        <p class="field-hint">
                            Укажите данные сотрудника,
                            которого переводят между отделами.
                        </p>
                    </div>

                    <div class="information-box">
                        После отправки формы будут автоматически
                        упомянуты начальник и заместитель исходного отдела,
                        а также начальник и заместитель принимающего отдела.
                    </div>

                    <button
                        id="submit-button"
                        class="submit-button"
                        type="submit"
                    >
                        <span>🔁</span>

                        <span id="submit-button-text">
                            Оформить перевод
                        </span>
                    </button>
                </form>
            </div>
        </section>
    </main>

    <script>
        const transferForm =
            document.getElementById(
                "staff-transfer-form"
            );

        const fromDepartmentSelect =
            document.getElementById(
                "fromDepartment"
            );

        const toDepartmentSelect =
            document.getElementById(
                "toDepartment"
            );

        const sameDepartmentWarning =
            document.getElementById(
                "same-department-warning"
            );

        const submitButton =
            document.getElementById(
                "submit-button"
            );

        const submitButtonText =
            document.getElementById(
                "submit-button-text"
            );

        function updateFormState() {
            const fromDepartment =
                fromDepartmentSelect.value;

            const toDepartment =
                toDepartmentSelect.value;

            const sameDepartment =
                Boolean(
                    fromDepartment
                    && toDepartment
                    && fromDepartment === toDepartment
                );

            sameDepartmentWarning.classList.toggle(
                "visible",
                sameDepartment
            );

            submitButton.disabled =
                sameDepartment;
        }

        fromDepartmentSelect.addEventListener(
            "change",
            updateFormState
        );

        toDepartmentSelect.addEventListener(
            "change",
            updateFormState
        );

        transferForm.addEventListener(
            "submit",
            function (event) {
                if (
                    fromDepartmentSelect.value
                    && toDepartmentSelect.value
                    && fromDepartmentSelect.value
                        === toDepartmentSelect.value
                ) {
                    event.preventDefault();

                    updateFormState();

                    return;
                }

                submitButton.disabled = true;

                submitButtonText.textContent =
                    "Отправка перевода...";
            }
        );

        updateFormState();
    </script>
</body>
</html>